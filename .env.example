# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expense_tracker?schema=public"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# App
PORT=3000
NODE_ENV="development"
API_PREFIX="api/v1"

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Timezone
DEFAULT_TIMEZONE="Asia/Kolkata"

# Salary
DEFAULT_SALARY_DAY=10
DEFAULT_SALARY_AMOUNT=87500

# Google Auth
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# Gemini AI (for natural language transaction parsing)
GEMINI_API_KEY=""
